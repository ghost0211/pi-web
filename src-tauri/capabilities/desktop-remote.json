{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-remote",
  "description": "Grants the loopback-hosted pi-web pages access to desktop settings, native file picking/open, native notifications, and file-drop events.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "allow-get-close-behavior",
    "allow-set-close-behavior",
    "allow-pick-attachment-paths",
    "allow-open-local-path",
    "allow-open-local-path-with",
    "allow-reveal-local-path",
    "allow-send-desktop-notification",
    "allow-prepare-desktop-update",
    "allow-get-lan-access",
    "allow-set-lan-access",
    "updater:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
