{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Web",
  "version": "../package.json",
  "identifier": "com.github.ghost0211.pi-web",
  "build": {
    "frontendDist": "../desktop/loading",
    "devUrl": "http://127.0.0.1:30141",
    "beforeBuildCommand": "npm run desktop:server"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["server/", "node/"],
    "shortDescription": "Desktop client for the pi coding agent",
    "longDescription": "Pi Web Desktop bundles the pi-web server and a Node.js runtime so the pi coding agent web UI runs as a native Windows application.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
