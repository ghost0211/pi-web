{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Web Desktop",
  "version": "../package.json",
  "identifier": "com.github.ghost0211.pi-web",
  "build": {
    "frontendDist": "../desktop/loading",
    "devUrl": "http://127.0.0.1:30141",
    "beforeBuildCommand": "npm run desktop:server"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["server/", "node/"],
    "shortDescription": "Desktop client for the pi coding agent",
    "longDescription": "Pi Web Desktop bundles the pi-web server and a Node.js runtime so the pi coding agent web UI runs as a native Windows application.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzREREQTU4RkZCMTYwNzUKUldSMVlMSC9XTnJkc3p1Y3pMdTFGV0FWQXg3TEM2T0I4cHhhdVBLRnoxZnpxaDQyenlZbGR1QlYK",
      "endpoints": ["https://github.com/ghost0211/pi-web/releases/latest/download/desktop-latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
